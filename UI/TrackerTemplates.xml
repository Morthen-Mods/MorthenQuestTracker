<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\Blizzard_SharedXML\UI.xsd">

    <!--
        Mode tab: the same LargeSideTabButtonTemplate (Blizzard_SharedXML/SharedUIPanelTemplates.xml,
        mixin SidePanelTabButtonMixin) CharacterFrame uses for CharacterFrameModeTab1-6. Only needs
        an icon (`iconTexture` KeyValue) and a tooltip (`tooltipText` KeyValue) per instance;
        MQT_ModeTabButtonMixin wires up the click handler on top.
    -->
    <Frame name="MQT_TabButtonTemplate" inherits="LargeSideTabButtonTemplate" mixin="MQT_TabButtonMixin" virtual="true">
        <KeyValues>
            <KeyValue key="fillToInterior" value="true" type="boolean"/>
        </KeyValues>
        <Scripts>
            <OnLoad method="OnLoad"/>
        </Scripts>
    </Frame>

    <Frame name="MQT_MainFrameTemplate" inherits="PortraitFrameTemplate" mixin="MQT_MainFrameMixin" virtual="true">
        <Size x="700" y="380"/>
        <Scripts>
            <OnLoad method="OnLoad"/>
        </Scripts>
        <Anchors>
            <Anchor point="CENTER"/>
        </Anchors>
        <Frames>
            <Frame parentKey="WorldZonesTab" parentArray="Tabs" inherits="MQT_TabButtonTemplate" id="1">
                <Anchors>
                    <Anchor point="TOPLEFT" relativePoint="TOPRIGHT" y="-30"/>
                </Anchors>
            </Frame>
            <Frame parentKey="DungeonsTab" parentArray="Tabs" inherits="MQT_TabButtonTemplate" id="2">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.WorldZonesTab" relativePoint="BOTTOMLEFT" y="-2"/>
                </Anchors>
            </Frame>
            <Frame parentKey="RaidsTab" parentArray="Tabs" inherits="MQT_TabButtonTemplate" id="3">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.DungeonsTab" relativePoint="BOTTOMLEFT" y="-2"/>
                </Anchors>
            </Frame>
            <Frame parentKey="MiscTab" parentArray="Tabs" inherits="MQT_TabButtonTemplate" id="4">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.RaidsTab" relativePoint="BOTTOMLEFT" y="-2"/>
                </Anchors>
            </Frame>
        </Frames>
    </Frame>

    <Frame name="MQT_QuestScrollFrameTemplate" inherits="InsetFrameTemplate" mixin="MQT_QuestScrollFrameMixin" virtual="true">
        <Size x="240"/>

        <Scripts>
            <OnLoad method="OnLoad"/>
        </Scripts>

        <Frames>
            <DropdownButton parentKey="Dropdown" inherits="WowStyle1DropdownTemplate">
                <Size y="24"/>
                <Anchors>
                    <Anchor point="BOTTOMLEFT" relativePoint="TOPLEFT" x="4" y="3"/>
                    <Anchor point="BOTTOMRIGHT" relativePoint="TOPRIGHT" x="-4"/>
                </Anchors>
            </DropdownButton>
            <Frame parentKey="ScrollBox" inherits="WowScrollBoxList">
                <Anchors>
                    <Anchor point="TOPLEFT"  x="6" y="-6"/>
                    <Anchor point="TOPRIGHT" x="-24"/>
                    <Anchor point="BOTTOM"   y="6"/>
                </Anchors>
            </Frame>
            <EventFrame parentKey="ScrollBar" inherits="MinimalScrollBar">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.ScrollBox" relativePoint="TOPRIGHT" x="4" y="-3"/>
                    <Anchor point="BOTTOMLEFT" relativeKey="$parent.ScrollBox" relativePoint="BOTTOMRIGHT" x="4" y="2"/>
                </Anchors>
            </EventFrame>
        </Frames>
    </Frame>

    <!--
        Header bar: inherits Blizzard's own collapsible list header instead of re-creating its
        atlas/CollapseButton wiring (Blizzard_SharedXML/ListTemplates.xml, AllowLoad: Both -> also
        loaded on Classic). Gives us the CollapseButton child, title region and hover highlight for
        free; MQT_HeaderMixin only adds the click-to-toggle behavior on top.
    -->
    <Button name="MQT_HeaderTemplate" inherits="ListHeaderVisualTemplate" mixin="MQT_HeaderMixin" virtual="true">
        <Size x="190" y="30"/>
        <Scripts>
            <OnLoad method="OnLoad"/>
            <OnClick method="OnClick"/>
        </Scripts>
    </Button>

    <Button name="MQT_EntryTemplate" mixin="MQT_EntryMixin" virtual="true">
        <Size x="200" y="16"/>
        <Layers>
            <Layer level="ARTWORK">
                <FontString parentKey="Text" inherits="GameFontHighlight" justifyH="LEFT" justifyV="TOP">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="0" y="0"/>
                    </Anchors>
                </FontString>
            </Layer>
            <Layer level="HIGHLIGHT">
                <Texture parentKey="Highlight" file="Interface\QuestFrame\UI-QuestTitleHighlight" alphaMode="ADD">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="-4" y="1"/>
                        <Anchor point="BOTTOMRIGHT" x="4" y="-1"/>
                    </Anchors>
                    <Color r="1" g="1" b="1" a="0.30"/>
                </Texture>
            </Layer>
        </Layers>
    </Button>
</Ui>
